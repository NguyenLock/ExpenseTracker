NODE_ENV=development
PORT=3001

# Local Postgres (docker compose). Leave DATABASE_URL empty.
DB_HOST=localhost
DB_PORT=5435
DB_USER=expense
DB_PASSWORD=expense
DB_NAME=expense_tracker

# Production (Neon). When this is set, DB_* is ignored and SSL is enabled.
# Example: postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Browser origin allowed to send cookies. One exact URL, not *.
# Local: http://localhost:3000
# Production: https://YOUR_PROJECT.vercel.app
# Auth cookies are Secure + SameSite=None, so production frontend AND API must be HTTPS.
FRONTEND_URL=http://localhost:3000

# Generate with: openssl rand -base64 48
# Never commit the real values.
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Optional. The API still boots if these are empty; chat endpoints return 502.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
